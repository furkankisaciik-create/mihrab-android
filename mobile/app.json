{
  "expo": {
    "name": "MIHRAB",
    "slug": "mihrab",
    "version": "1.0.1",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "mihrab",
    "userInterfaceStyle": "light",
    "ios": {
      "bundleIdentifier": "com.ezgic.mihrab",
      "icon": "./assets/expo.icon"
    },
    "android": {
      "package": "com.ezgic.mihrab",
      "permissions": [
        "SCHEDULE_EXACT_ALARM",
        "POST_NOTIFICATIONS"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "server",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "MIHRAB; bulunduğunuz il ve ilçeye ait Diyanet namaz vakitlerini, Kâbe yönünü ve yakındaki camileri göstermek için konumunuzu kullanır."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/images/android-icon-monochrome.png",
          "color": "#1A594B",
          "defaultChannel": "mihrab-prayer-sound-v1"
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#123E36",
          "android": {
            "image": "./assets/images/splash-icon.png",
            "imageWidth": 76
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
